{
  "expo": {
    "name": "Togeco",
    "slug": "togeco",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "togeco",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syouzen.togeco"
    },
    "android": {
      "package": "com.syouzen.togeco",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE066"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "기프티콘 이미지를 등록하려면 사진 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFE066"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
