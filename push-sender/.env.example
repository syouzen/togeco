# PocketBase 접속 (같은 NAS면 내부 주소 권장)
PB_URL=http://localhost:8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me

# VAPID 키 (npx web-push generate-vapid-keys 로 생성)
# 공개키는 웹 프론트 NEXT_PUBLIC_VAPID_PUBLIC_KEY 와 동일한 값을 써야 함
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 선택 — 폴링 주기(ms), 푸시 TTL(초)
POLL_INTERVAL_MS=60000
PUSH_TTL_SECONDS=86400
